# Reschedule UMU components for better performance and quick launch times
# Most of those go away after opening the game, they are needed for launching the container
# They are REALLY both CPU and IO heavy, so must not lag
# https://github.com/Open-Wine-Components/umu-launcher

{ "name": "pv-adverb", "type": "LowLatency_RT" }

{ "name": "ldconfig", "type": "LowLatency_RT" }

{ "name": "pressure-vessel-wrap", "type": "LowLatency_RT" }

{ "name": "i386-gnu-inspect-lib", "type": "LowLatency_RT" }

{ "name": "x86_64-gnu-inspect-l", "type": "LowLatency_RT" }

{ "name": "i386-linux-gnu-srt-l", "type": "LowLatency_RT" }

{ "name": "x86_64-linux-gnu-srt", "type": "LowLatency_RT" }
